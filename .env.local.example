NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
QR_SIGNING_SECRET=change-me-to-a-long-random-secret
WHATSAPP_API_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# Production (Cloudflare Worker):
# - Set runtime secrets in the dashboard as Encrypted (Secret), not plaintext Text.
# - Plaintext vars are wiped on deploy unless you use `npm run deploy` (--keep-vars).
# - Prefer: wrangler secret put QR_SIGNING_SECRET
# Optional for cron Edge Function:
# CRON_SECRET=

# Optional: Google Maps / Business reviews (scripts/fetch-google-reviews.ts)
# Prefer SerpAPI or Outscraper for the full public review list.
# Google Places API is official but returns at most 5 reviews.
# SERPAPI_API_KEY=
# OUTSCRAPER_API_KEY=
# GOOGLE_PLACES_API_KEY=
